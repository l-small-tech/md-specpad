{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for every app window — 'main', torn-off tab windows (label 'w-*'), and the transient tab-drag ghost windows ('ghost-*'). Custom commands in src/commands/ need no entries here — only core/plugin permissions do.",
  "windows": [
    "main",
    "w-*",
    "ghost-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "core:window:allow-set-fullscreen",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-cursor-position",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-is-minimized",
    "core:window:allow-title",
    "core:window:allow-set-position",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-ignore-cursor-events",
    "dialog:default",
    "store:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "ms-settings:privacy-speech"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/whisper"
        },
        {
          "path": "$APPDATA/agent-modules"
        }
      ]
    },
    "log:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text"
  ]
}
